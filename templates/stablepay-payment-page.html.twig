<div id="stablepay-payment" style="max-width: 560px; margin: 2rem auto; font-family: system-ui, sans-serif;">
  <div id="stablepay-container" style="background: var(--surface, #fff); border-radius: 12px; padding: 2rem; box-shadow: 0 2px 8px rgba(0,0,0,0.1);" 
       data-order-id="{{ order_id }}" 
       data-amount="{{ amount }}" 
       data-currency="{{ currency }}" 
       data-networks='{{ networks }}'
       data-address="{{ address }}"
       data-expires-at="{{ expires_at }}"
       data-status-url="{{ status_url }}" 
       data-notify-url="{{ notify_url }}" 
       data-return-url="{{ return_url }}" 
       data-onchain-balance='{{ onchain_balance }}'>
  </div>
</div>
