[Unit]
Description=StablePay Sidecar Listener
After=apache2.service
Requires=apache2.service

[Service]
Type=simple
WorkingDirectory=/var/www/latina/web/modules/custom/commerce_stablepay/node
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
Environment=DRUPAL_BASE_URL=https://127.0.0.1
Environment=DRUPAL_HOST=lrtv.jaranetwork.com
StandardOutput=append:/var/log/stablepay-listener.log
StandardError=append:/var/log/stablepay-listener.log

[Install]
WantedBy=multi-user.target
